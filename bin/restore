#!/bin/sh
set -eu
export LC_ALL=C

usage="usage: bin/restore --postgres|--clickhouse NAME [--as OTHER] [--snapshot ID]"

die() {
	echo "restore: $1" >&2
	exit 1
}

datastore=
name=
other=
as=
snapshot=
count=0
while [ $# -gt 0 ]; do
	case $1 in
	--postgres | --clickhouse)
		[ -z "$datastore" ] || die "name one datastore, --postgres or --clickhouse, not both. $usage"
		datastore=${1#--}
		;;
	--as)
		[ $# -ge 2 ] || die "--as needs a name. $usage"
		as=1
		other=$2
		shift
		;;
	--snapshot)
		[ $# -ge 2 ] || die "--snapshot needs an ID. $usage"
		snapshot=$2
		shift
		;;
	-*) die "$1 is not an option. $usage" ;;
	*)
		name=$1
		count=$((count + 1))
		;;
	esac
	shift
done
[ -n "$datastore" ] || die "name the datastore, --postgres or --clickhouse. $usage"
[ "$count" -eq 1 ] || die "$usage"

check_name() {
	case $1 in
	'') die "a name is required. $usage" ;;
	[!a-z]* | *[!a-z0-9_]*) die "'$1' is not a database name. Use a-z, 0-9 and _, and start with a letter." ;;
	esac
	[ "${#1}" -le 63 ] || die "'$1' is longer than 63 characters."
	case $datastore:$1 in
	postgres:postgres | postgres:template0 | postgres:template1 | postgres:pgbouncer_auth | postgres:pg_*) die "'$1' belongs to Postgres or its doors." ;;
	clickhouse:default | clickhouse:system | clickhouse:information_schema) die "'$1' belongs to ClickHouse." ;;
	esac
}

check_name "$name"
[ -z "$as" ] || check_name "$other"
case $snapshot in
*[!0-9a-f]*) die "'$snapshot' is not a snapshot ID. docker exec archivist restic snapshots lists them." ;;
esac

dumper=$datastore-dumper
docker exec archivist true >/dev/null 2>&1 ||
	die "cannot reach the archivist. Put compose/archivist.yml in COMPOSE_FILE, and run docker compose up -d."
docker exec "$dumper" true >/dev/null 2>&1 ||
	die "cannot reach $dumper. Put compose/$datastore.yml in COMPOSE_FILE, and run docker compose up -d."

if [ "$datastore" = postgres ]; then
	file=/postgres/databases/$name.dump
	count_of() {
		docker exec postgres-18 psql -v ON_ERROR_STOP=1 -X -tA -U postgres -d postgres -c "SELECT count(*) FROM $1 WHERE $2 = '$3'"
	}
	databases=pg_database
	database_column=datname
	users=pg_roles
	user_column=rolname
else
	file=/clickhouse/databases/$name.tar
	count_of() {
		docker exec clickhouse clickhouse-client --query "SELECT count() FROM $1 WHERE $2 = '$3'"
	}
	databases=system.databases
	database_column=name
	users=system.users
	user_column=name
fi

count_of "$databases" "$database_column" "$name" >/dev/null 2>&1 ||
	die "cannot reach $datastore. Put compose/$datastore.yml in COMPOSE_FILE, and run docker compose up -d."

if [ -n "$as" ]; then
	[ "$(count_of "$databases" "$database_column" "$other")" = 0 ] ||
		die "the database $other already exists. Nothing was changed. Name another, or bin/remove-database --$datastore $other first."
elif [ "$(count_of "$users" "$user_column" "$name")" = 0 ]; then
	die "there is no user $name, so its database cannot come back as it was. Nothing was changed. Make it with bin/add-database --$datastore $name, which prints a new password, then run this again."
fi

cleanup() {
	docker exec "$dumper" rm -f "/backups/restore$file"
}
trap cleanup EXIT

if [ -n "$snapshot" ]; then
	docker exec archivist archivist fetch "$file" "$snapshot" >/dev/null ||
		die "the snapshot $snapshot holds no archive of $name. Nothing was changed."
else
	docker exec archivist archivist fetch "$file" >/dev/null ||
		die "the bucket holds no archive of $name. Nothing was changed."
fi

if [ -n "$as" ]; then
	docker exec "$dumper" dumper restore "$name" "$other" ||
		die "the archive of $name did not come back as $other. bin/remove-database --$datastore $other clears what is left."
	echo "The archive of $name is restored as $other. Nothing live was touched."
	echo "bin/remove-database --$datastore $other drops it when you are done."
	exit 0
fi

echo "This replaces the database $name with its archive. Every change made to it since is lost."
echo "Stop whatever uses $name first."
printf 'Type %s to go ahead: ' "$name"
answer=
read -r answer || true
if [ "$answer" != "$name" ]; then
	echo "Nothing was restored."
	exit 1
fi

docker exec "$dumper" dumper restore "$name" ||
	die "the archive of $name did not come back. The database may be gone or half restored; run this again."
echo "The database $name is restored from its archive."
