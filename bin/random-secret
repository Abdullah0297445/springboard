#!/bin/sh
set -eu
export LC_ALL=C

usage="usage: bin/random-secret [LENGTH]"

die() {
	echo "random-secret: $1" >&2
	exit 1
}

[ $# -le 1 ] || die "$usage"
length=64
[ $# -eq 0 ] || length=$1
case $length in
'' | 0* | *[!0-9]*) die "'$length' is not a length. Give a whole number of characters, such as 32. $usage" ;;
esac

secret=$(od -An -tx1 -N$(((length + 1) / 2)) /dev/urandom | tr -d ' \n' | cut -c "1-$length")
[ "${#secret}" -eq "$length" ] || die "could not read $length characters from /dev/urandom."
echo "$secret"
