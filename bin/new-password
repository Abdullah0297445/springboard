#!/bin/sh
set -eu
export LC_ALL=C

usage="usage: bin/new-password --postgres [--session] NAME, or bin/new-password --clickhouse NAME"

die() {
	echo "new-password: $1" >&2
	exit 1
}

datastore=
session=
name=
count=0
for argument in "$@"; do
	case $argument in
	--postgres | --clickhouse)
		[ -z "$datastore" ] || die "name one datastore, --postgres or --clickhouse, not both. $usage"
		datastore=${argument#--}
		;;
	--session) session=1 ;;
	-*) die "$argument is not an option. $usage" ;;
	*)
		name=$argument
		count=$((count + 1))
		;;
	esac
done
[ -n "$datastore" ] || die "name the datastore, --postgres or --clickhouse. $usage"
[ "$count" -eq 1 ] || die "$usage"

case $name in
'') die "a name is required. $usage" ;;
[!a-z]* | *[!a-z0-9_]*) die "'$name' is not a user's name. Use a-z, 0-9 and _, and start with a letter." ;;
esac
[ "${#name}" -le 63 ] || die "'$name' is longer than 63 characters."

new_password() {
	od -An -tx1 -N16 /dev/urandom | tr -d ' \n'
}

if [ "$datastore" = clickhouse ]; then
	[ -z "$session" ] || die "--session is for Postgres, and --clickhouse does not take it. $usage"
	[ "$name" != default ] || die "default is a superuser. Its password is changed by hand, and the README says how."

	clickhouse_query() {
		docker exec clickhouse clickhouse-client --query "$1"
	}

	clickhouse_query "SELECT 1" >/dev/null 2>&1 ||
		die "cannot reach clickhouse. Put compose/clickhouse.yml in COMPOSE_FILE, and run docker compose up -d."

	[ "$(clickhouse_query "SELECT count() FROM system.users WHERE name = '$name'")" = 1 ] ||
		die "there is no user $name on ClickHouse. Nothing was changed."
	[ "$(clickhouse_query "SELECT count() FROM system.databases WHERE name = '$name'")" = 1 ] ||
		die "$name is not a database's user on ClickHouse. Nothing was changed."

	password=$(new_password)
	[ "${#password}" -eq 32 ] || die "could not read 16 bytes from /dev/urandom."

	docker exec -i clickhouse clickhouse-client <<SQL
ALTER USER "$name" IDENTIFIED BY '$password';
SQL

	echo "The user $name on ClickHouse has a new password. The old one no longer logs in."
	echo "It is shown here once. ClickHouse keeps no copy you can read back."
	echo
	echo "For a consumer:"
	echo
	echo "  CLICKHOUSE_URL=clickhouse://$name:$password@clickhouse:9000/$name"
	echo
	echo "For a product, put this line in Infisical, in the project userland, environment prod, and run bin/up."
	echo "On a host without Infisical, put it in .env instead, and run docker compose up -d:"
	echo
	echo "  $(echo "$name" | tr '[:lower:]' '[:upper:]')_CLICKHOUSE_PASSWORD=$password"
	exit 0
fi

case $name in
pg_*) die "'$name' belongs to Postgres." ;;
esac

run() {
	docker exec -i postgres-18 psql -v ON_ERROR_STOP=1 -X --quiet -U postgres -d postgres
}

query() {
	docker exec postgres-18 psql -v ON_ERROR_STOP=1 -X -tA -U postgres -d postgres -c "$1"
}

query "SELECT 1" >/dev/null 2>&1 ||
	die "cannot reach postgres-18. Put compose/postgres.yml in COMPOSE_FILE, and run docker compose up -d."

user=$(query "SELECT rolsuper FROM pg_roles WHERE rolname = '$name' AND rolcanlogin")
[ -n "$user" ] || die "there is no user $name that logs in. Nothing was changed."
[ "$user" = f ] || die "$name is a superuser. Its password is changed by hand, and the README says how."

database_of() {
	query "SELECT 1 FROM pg_database WHERE datname = '$1'"
}

kind=
if [ "$name" = pgbouncer_auth ]; then
	kind=doors
elif [ -n "$(database_of "$name")" ]; then
	kind=user
else
	case $name in
	*_authenticator)
		database=${name%_authenticator}
		[ -z "$(database_of "$database")" ] || kind=authenticator
		;;
	esac
fi
[ -n "$kind" ] || die "$name is not a database's user, PostgREST's authenticator, or pgbouncer_auth. Nothing was changed."

password=$(new_password)
[ "${#password}" -eq 32 ] || die "could not read 16 bytes from /dev/urandom."

run <<SQL
ALTER ROLE "$name" PASSWORD '$password';
SQL

if [ -n "$session" ]; then
	door=pgbouncer-session
	door_name="session door"
else
	door=pgbouncer-transaction
	door_name="transaction door"
fi

echo "The user $name has a new password. The old one no longer logs in."
echo "It is shown here once. Postgres keeps no copy you can read back."
echo
if [ "$kind" = doors ]; then
	echo "Put this line in Infisical, in the project userland, environment prod, and run bin/up."
	echo "On a host without Infisical, put it in .env instead, and run docker compose up -d."
	echo "Either one recreates both doors, and postgres-18 too. Until then, the doors may refuse new logins."
	echo
	echo "  PGBOUNCER_AUTH_PASSWORD=$password"
	echo
	echo "It is a recovery key, so change your copy off the host too."
	exit 0
fi
if [ "$kind" = authenticator ]; then
	echo "For PostgREST, through the session door:"
	echo
	echo "  PGRST_DB_URI=postgresql://$name:$password@pgbouncer-session:5432/$database"
	exit 0
fi
echo "For a consumer, through the $door_name:"
echo
echo "  DATABASE_URL=postgresql://$name:$password@$door:5432/$name"
echo
echo "For a product, put this line in Infisical, in the project userland, environment prod, and run bin/up."
echo "On a host without Infisical, put it in .env instead, and run docker compose up -d:"
echo
echo "  $(echo "$name" | tr '[:lower:]' '[:upper:]')_DB_PASSWORD=$password"
