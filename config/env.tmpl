{{- $lines := listSecretsByProjectSlug "userland" "prod" "/" `{"expandSecretReferences": false}` -}}
{{- if not $lines }}{{ fail "the project userland holds no line in its environment prod" }}{{ end -}}
{{- range $lines }}{{ .Key }}="{{ .Value | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "$$" | replace "\n" "\\n" }}"
{{ end -}}
